# Copy to ".env" (same folder as the notebook) and fill in. NEVER commit or share the real .env.
# Use testnet-only wallets — never a wallet that holds real ETH.

INFURA_API_KEY=your_infura_project_id
DEPLOYER_PRIVATE_KEY=0xyour_deployer_private_key

# One block per group member betting from this laptop
MEMBER_1_NAME=Max
MEMBER_1_PRIVATE_KEY=0x...
MEMBER_2_NAME=
MEMBER_2_PRIVATE_KEY=
MEMBER_3_NAME=
MEMBER_3_PRIVATE_KEY=
MEMBER_4_NAME=
MEMBER_4_PRIVATE_KEY=
MEMBER_5_NAME=
MEMBER_5_PRIVATE_KEY=

# Fill in after the first deployment so re-runs (and the live demo) reuse the same contract
CONTRACT_ADDRESS=

# "sepolia" (default) or "local" for an offline rehearsal
NETWORK_MODE=sepolia
